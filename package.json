    "@tauri-apps/plugin-updater": "^2.13.1",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "mathjax": "^3.2.2",
    "mermaid": "^11.17.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
