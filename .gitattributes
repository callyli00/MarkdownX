# Normalize line endings in the repository; check out with the platform default.
* text=auto eol=lf

# Source files that must stay byte-exact (never CRLF-converted)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never diffed, never line-ending converted
*.png binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary

# Bundled third-party runtime (vendored, not hand-edited)
public/mathjax/*.js -diff linguist-vendored